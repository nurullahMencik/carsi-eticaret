# SQLite file (relative paths are resolved from the project root).
DATABASE_URL="file:./data/carsi.db"

# Auth.js secret. Local/CI use a built-in development value when unset;
# in production a random value is generated at startup (with a warning) if missing.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL (used for sitemap, OpenGraph, iyzico callback). On Render,
# RENDER_EXTERNAL_URL is used automatically when SITE_URL is not set.
SITE_URL="http://localhost:5309"

# Optional: iyzico sandbox keys. When both are empty the demo payment provider is used.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Optional: Resend. When empty, e-mails are only logged (console + EmailLog table).
RESEND_API_KEY=""
EMAIL_FROM="Çarşı <siparis@carsi.demo>"
