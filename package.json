{
  "name": "carsi-eticaret",
  "version": "1.0.0",
  "private": true,
  "description": "Çarşı - full-stack boutique e-commerce with payments (iyzico / demo), order state machine and an admin panel. Next.js App Router + Prisma.",
  "license": "MIT",
  "author": "Nurullah Mencik",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 5309",
    "build": "next build",
    "start": "next start --port 5309",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "images:fetch": "tsx scripts/fetch-images.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "next-auth": "^5.0.0-beta.32",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "lighthouse": "^13.6.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
