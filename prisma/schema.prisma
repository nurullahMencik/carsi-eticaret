// Çarşı data model.
//
// Portability notes (SQLite today, PostgreSQL later):
// - No database enums: status/role/type columns are plain strings validated with Zod
//   in `src/lib/domain/*` (see ORDER_STATUSES, ROLES, COUPON_TYPES ...).
// - No Json columns: structured audit data is stored as JSON text.
// - Money is always an integer amount of kuruş (1 TRY = 100 kuruş), VAT-inclusive.
// - Case-insensitive search uses a normalised `searchText` column instead of
//   provider-specific collations or `mode: "insensitive"`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// CUSTOMER | STAFF | ADMIN
  role         String   @default("CUSTOMER")
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  cart         Cart?
  auditLogs    AuditLog[]
  statusEvents OrderStatusEvent[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  fullName   String
  phone      String
  city       String
  district   String
  line       String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameTr        String
  nameEn        String
  descriptionTr String    @default("")
  descriptionEn String    @default("")
  imageUrl      String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  nameTr         String
  nameEn         String
  shortDescTr    String
  shortDescEn    String
  descriptionTr  String
  descriptionEn  String
  /// Base unit price in kuruş, VAT included.
  price          Int
  /// Optional "was" price in kuruş, VAT included.
  compareAtPrice Int?
  /// VAT percentage (e.g. 20 or 10). Prices already include it.
  vatRate        Int      @default(20)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  /// Lower-cased, Turkish-folded names/descriptions for portable search.
  searchText     String   @default("")
  ratingAvg      Float    @default(0)
  ratingCount    Int      @default(0)
  soldCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive, price])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altTr     String  @default("")
  altEn     String  @default("")
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  colorTr    String?
  colorEn    String?
  colorHex   String?
  size       String?
  /// Added to the product price (kuruş). Can be negative.
  priceDelta Int      @default(0)
  stock      Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Guest carts are identified by an opaque random token stored in a cookie.
  token      String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  /// PERCENT | FIXED
  type          String
  /// Percent (1-100) for PERCENT, kuruş for FIXED.
  value         Int
  minSubtotal   Int       @default(0)
  maxDiscount   Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  descriptionTr String    @default("")
  descriptionEn String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Order {
  id              String    @id @default(cuid())
  number          String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  email           String
  /// PENDING | PAID | PREPARING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  status          String    @default("PENDING")
  /// UNPAID | PAID | FAILED | REFUNDED
  paymentStatus   String    @default("UNPAID")
  /// DEMO | IYZICO
  paymentProvider String
  isDemoPayment   Boolean   @default(false)
  paymentRef      String?
  paymentToken    String?   @unique
  shipFullName    String
  shipPhone       String
  shipCity        String
  shipDistrict    String
  shipLine        String
  shipPostalCode  String?
  subtotal        Int
  discount        Int       @default(0)
  shippingFee     Int       @default(0)
  total           Int
  vatTotal        Int
  couponCode      String?
  carrier         String?
  trackingNumber  String?
  locale          String    @default("tr")
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  items    OrderItem[]
  events   OrderStatusEvent[]
  payments PaymentAttempt[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  productNameTr String
  productNameEn String
  variantLabel  String         @default("")
  sku           String
  imageUrl      String?
  unitPrice     Int
  quantity      Int
  vatRate       Int
  lineTotal     Int

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// SYSTEM | CUSTOMER | STAFF | ADMIN
  actorRole  String
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// DEMO | IYZICO
  provider     String
  /// INITIATED | SUCCEEDED | FAILED | REFUNDED
  status       String
  amount       Int
  providerRef  String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  entityType String
  entityId   String
  summary    String
  /// JSON text: { before?: object, after?: object }
  changes    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  template   String
  /// SENT | LOGGED | FAILED
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
